# Separate public-app entry point: pnpm start:public (Node 24).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example
DATABASE_PATH=/data/dealify.sqlite
# Generate 32 random bytes encoded as base64; keep this key with encrypted backups.
DATA_ENCRYPTION_KEY=
SUPPORT_EMAIL=

# Off until the account's Backboard/downstream retention and training terms are verified.
PUBLIC_AI_ENABLED=false
BACKBOARD_API_KEY=
BACKBOARD_MODEL_PROVIDER=openai
BACKBOARD_MODEL_NAME=
BACKBOARD_TIMEOUT_MS=6500
# Actual review date and downstream provider terms URL; see docs/PUBLIC-AI.md.
BACKBOARD_TERMS_REVIEWED_AT=
BACKBOARD_PROVIDER_TERMS_URL=
PILOT_DAILY_TURNS=500
